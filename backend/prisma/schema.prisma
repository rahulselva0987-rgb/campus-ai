generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("student")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
}

model StudentProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  fullName     String
  department   String   @default("Computer Science")
  year         Int      @default(1)
  bio          String   @default("")
  careerGoal   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activities   Activity[]
  certificates Certificate[]
  studentSkills StudentSkill[]
  recommendations Recommendation[]
}

model Activity {
  id          String   @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  title       String
  category    String
  organization String  @default("")
  description String   @default("")
  date        DateTime @default(now())
  achievement String   @default("")
  createdAt   DateTime @default(now())
}

model Certificate {
  id           String   @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id])
  title        String
  organization String   @default("")
  issueDate    String   @default("")
  category     String   @default("General")
  achievement  String   @default("")
  status       String   @default("pending")
  fileName     String   @default("")
  filePath     String   @default("")
  extractedData String  @default("{}")
  reviewNote   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String   @default("General")
  description String   @default("")

  studentSkills StudentSkill[]
}

model StudentSkill {
  id        String   @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id])
  level     Int      @default(1)
  evidence  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([studentId, skillId])
}

model Recommendation {
  id          String   @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  title       String
  description String
  reason      String
  type        String
  createdAt   DateTime @default(now())
}